{
  "expo": {
    "name": "ShopSphere",
    "slug": "shopsphere",
    "scheme": "shopsphere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appAssets/appIcon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DCF2E3",
        "foregroundImage": "./assets/appAssets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.baig1212.shopsphere"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-image",
      "expo-sharing"
    ]
  }
}
